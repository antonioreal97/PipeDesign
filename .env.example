# =================================================================
# PipeDesign — variáveis de ambiente
# Copie para .env (cp .env.example .env) e preencha. NUNCA commite o .env.
# Gere segredos com: openssl rand -hex 32
# =================================================================

# -------------------------------------------------
# DOCKER COMPOSE
# -------------------------------------------------
COMPOSE_PROJECT_NAME=pipedesign
TZ=America/Sao_Paulo

# -------------------------------------------------
# CANVA (Canva Developer Portal > Your integrations)
# Usado SOMENTE pelo serviço canva-auth. Não é repassado ao n8n.
# -------------------------------------------------
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Precisa ser idêntica à cadastrada no Developer Portal.
# O Canva não aceita "localhost": use 127.0.0.1. A porta deve ser igual a CANVA_AUTH_PORT.
CANVA_REDIRECT_URI=http://127.0.0.1:3001/auth/canva/callback

CANVA_AUTH_URL=https://www.canva.com/api/oauth/authorize
CANVA_TOKEN_URL=https://api.canva.com/rest/v1/oauth/token
CANVA_API_BASE_URL=https://api.canva.com/rest/v1

# Scopes separados por espaço. Devem estar habilitados na integração no Developer Portal.
CANVA_SCOPES="asset:read asset:write brandtemplate:meta:read brandtemplate:content:read design:content:write design:meta:read"

CANVA_TEST_TEMPLATE_NAME="SPIKE - Social Post Template"
CANVA_TEST_BRAND_TEMPLATE_ID=

# -------------------------------------------------
# SERVIÇO LOCAL canva-auth
# -------------------------------------------------
# Endereço de escuta DENTRO do container. A porta publicada no host fica presa a 127.0.0.1.
CANVA_AUTH_HOST=0.0.0.0
CANVA_AUTH_PORT=3001

# Caminho do token store dentro do container (volume canva_auth_data).
TOKEN_STORE_PATH=/data/canva-token.json

# Opcional (recomendado): se definido, GET /auth/canva/token e POST /auth/canva/refresh
# exigem o header "x-api-key: <valor>". O n8n recebe o mesmo valor como variável.
CANVA_AUTH_API_KEY=

# Renovar o access token quando faltar menos que N segundos para expirar.
CANVA_TOKEN_REFRESH_SKEW_SECONDS=300
# Timeout das chamadas ao endpoint de token do Canva (ms).
CANVA_HTTP_TIMEOUT_MS=15000

# -------------------------------------------------
# POSTGRESQL + PGVECTOR
# -------------------------------------------------
POSTGRES_USER=pipedesign
POSTGRES_PASSWORD=change-me
# Banco interno do n8n (criado automaticamente).
POSTGRES_N8N_DB=n8n
# Banco da aplicação (marcas, assets, embeddings, jobs...). Criado com a extensão vector.
POSTGRES_APP_DB=pipedesign
# Porta publicada em 127.0.0.1 para acessar com psql/DBeaver a partir do host.
POSTGRES_PORT=5432
# Lembrete para a credencial n8n "PipeDesign Postgres": host=postgres, database=pipedesign,
# user=POSTGRES_USER, password=POSTGRES_PASSWORD. Depois: ./db/migrate.sh

# -------------------------------------------------
# N8N
# -------------------------------------------------
# Fixe uma versão (ex.: 2.x.y) depois do primeiro setup para evitar upgrades inesperados.
N8N_IMAGE_TAG=latest
N8N_PORT=5678

# Obrigatório e PERMANENTE: criptografa as credenciais salvas no n8n.
# Se mudar depois, as credenciais existentes ficam ilegíveis.
N8N_ENCRYPTION_KEY=

# -------------------------------------------------
# IA — WF-02 (visão local + embeddings) e WF-05 (Art Director)
# -------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_ART_DIRECTOR_MODEL=gpt-4o-mini
# A análise visual e os embeddings são processados somente no Ollama local.
OLLAMA_IMAGE_TAG=latest
OLLAMA_PORT=11434
LOCAL_VISION_MODEL=gemma3:4b
LOCAL_EMBEDDING_MODEL=embeddinggemma
# Quantidade máxima de fotos lidas pelo WF-02 por execução. A indexação é incremental por SHA-256.
ASSET_INDEX_LIMIT=3
# Slug da marca indexada pelo WF-02 (tabela brands). O workspace_path da marca define a pasta permitida.
ASSET_INDEX_BRAND=exemplo
# Use um glob por lote, dentro de <workspace_path>/Fotos/. Vazio = <workspace_path>/Fotos/*.jpg.
ASSET_INDEX_GLOB=/workspace/clients/exemplo/Fotos/*.jpg

# -------------------------------------------------
# BANCO DE IMAGENS — fallback de cenas no WF-05
# -------------------------------------------------
# Crie gratuitamente em https://www.pexels.com/api/ e cole somente no .env local.
# A chave fica restrita ao draft-renderer; fotos locais continuam com prioridade.
PEXELS_API_KEY=
STOCK_MAX_SCENES=7
# Cache das buscas Pexels por 24h para reduzir consumo da cota da API.
STOCK_CACHE_TTL_SECONDS=86400

# -------------------------------------------------
# SPIKE (docs/CANVA_INTEGRATION_SPIKE.md)
# -------------------------------------------------
SPIKE_IMAGE_PATH=/workspace/spike/test-image.jpg
SPIKE_HEADLINE="Winter 26"
SPIKE_SUBHEADLINE="New Collection"
SPIKE_DESIGN_TITLE="SPIKE - Canva Autofill"
# Modo do workflow workflows/spike-canva-autofill.json:
#   upload_only -> token + upload de uma imagem (não precisa de Brand Template)
#   full        -> fluxo completo até o design editável (precisa do template e do Autofill)
#   import      -> importa PDF/PPTX de SPIKE_IMPORT_GLOB como designs editáveis (não precisa de Enterprise)
# Depois de mudar, recrie o n8n: docker compose up -d n8n
SPIKE_MODE=full
SPIKE_IMPORT_GLOB=/workspace/spike/import-test/*.{pdf,pptx}
SPIKE_POLL_INTERVAL_SECONDS=2
SPIKE_POLL_MAX_ATTEMPTS=30
