{
  "name": "@pipedesign/canva-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Serviço local de OAuth 2.0 + PKCE para a Canva Connect API (PipeDesign).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:local": "CANVA_AUTH_HOST=127.0.0.1 TOKEN_STORE_PATH=.data/canva-token.json node --env-file=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"build/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
